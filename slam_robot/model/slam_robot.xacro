<?xml version="1.0" ?>
<robot name="slam_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find slam_robot)/model/materials.xacro" />
<xacro:include filename="$(find slam_robot)/model/slam_robot.trans" />
<xacro:include filename="$(find slam_robot)/model/slam_robot.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>  <!-- CoM zentrieren -->
    
    <mass value="10.0"/> <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="MG995_1">
  <inertial>
    <origin xyz="0.00018178353418634162 -0.010000003571498842 -0.008552466740676883" rpy="0 0 0"/>
    <mass value="0.001"/> 
    <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 0.035 -0.054" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/MG995.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 0.035 -0.054" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/MG995.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

