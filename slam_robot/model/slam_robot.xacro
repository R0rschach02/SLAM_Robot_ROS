    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.0094 0.05075 -0.08034" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/TiltPart.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="TFLunaBenewake_1">
  <inertial>
    <origin xyz="2.2363284488124968e-10 -0.005554543875903067 -3.087080366198647e-07" rpy="0 0 0"/>
    <mass value="0.001"/> 
    <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0096 0.10075 -0.080268" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/TFLunaBenewake.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0096 0.10075 -0.080268" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/TFLunaBenewake.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Starr 1" type="fixed">
  <origin xyz="0.0 -0.035 0.054" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="MG995_1"/>
</joint>

<joint name="LeftWheelMotion" type="continuous">
  <origin xyz="-0.077 0.055 0.02501" rpy="0 0 0"/>  <!-- rpy entfernen -->
  <parent link="base_link"/>
  <child link="LeftMotor_1"/>
   <axis xyz="1.0 0.0 0.0"/>  <!-- oder -1, je nach Ausrichtung testen -->     <!-- eig. -1.0 -0.0 -0.0 -->
</joint>

<joint name="Starr 3" type="continuous">
  <origin xyz="-0.077 0.0 0.02501" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="LeftMiddleWheel_1"/>
  <axis xyz="1.0 -0.0 -0.0"/> 
</joint>

<joint name="Starr 4" type="continuous">
  <origin xyz="-0.077 -0.055 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="LeftFrontWheel_1"/>
  <axis xyz="1.0 -0.0 -0.0"/> 
</joint>

<joint name="Starr 5" type="continuous">
  <origin xyz="0.077 -0.055 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="RightFrontWheel_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="Starr 6" type="continuous">
  <origin xyz="0.077 0.0 0.02501" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="RightMiddleWheel_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="RightWheelMotion" type="continuous">
  <origin xyz="0.077 0.055 0.02501" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="RightMotor_1"/>
  <axis xyz="1.0 0.0 0.0"/>   <!-- eig. 1.0 0.0 0.0 -->
</joint>

<joint name="PanMotion" type="revolute">
  <origin xyz="0.0101 -0.01 0.0126" rpy="0 0 0"/>
  <parent link="MG995_1"/>
  <child link="PanPart_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
  <limit upper="0.959931" lower="-0.959931" effort="100" velocity="100"/>
</joint>

<joint name="Starr 9" type="fixed">
  <origin xyz="0.0 0.0 0.0195" rpy="0 0 0"/>
  <parent link="PanPart_1"/>
  <child link="MG90S_1"/>
</joint>

<joint name="TiltMotion" type="revolute">
  <origin xyz="-0.0195 -0.00575 -0.00576" rpy="0 0 0"/>
  <parent link="MG90S_1"/>
  <child link="TiltPart_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <limit upper="0.872665" lower="-0.523599" effort="100" velocity="100"/>
</joint>

<joint name="Starr 11" type="fixed">
  <origin xyz="0.019 -0.05 -7.2e-05" rpy="0 0 0"/>
  <parent link="TiltPart_1"/>
  <child link="TFLunaBenewake_1"/>
</joint>

<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>
  <joint name="PanMotion">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="TiltMotion">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

</robot>