    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/MG90S.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="TiltPart_1">
  <inertial>
    <origin xyz="0.00812846455655557 -0.03307294922540972 -5.5186871191603704e-05" rpy="0 0 0"/>
    <mass value="0.001"/> 
    <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="0.0094 0.05075 -0.08034" rpy="0 0 0"/>
    <geometry>
