      <!-- <cylinder radius="0.025" length="0.02"/> -->
    </geometry>
  </collision>
</link>

<link name="PanPart_1">
  <inertial>
    <origin xyz="7.735593309712158e-07 3.372936091555062e-05 0.012081173443687296" rpy="0 0 0"/>
    <mass value="0.001"/> 
    <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0101 0.045 -0.0666" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/PanPart.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0101 0.045 -0.0666" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find slam_robot)/meshes/PanPart.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="MG90S_1">
  <inertial>
    <origin xyz="-0.0012642843683621507 -0.00035463849594528224 -0.005750000639991523" rpy="0 0 0"/>
    <mass value="0.001"/> 
    <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0101 0.045 -0.0861" rpy="0 0 0"/>
